{
  "name": "jtab",
  "version": "1.0.0",
  "private": true,
  "description": "A privacy-first bookmark new tab extension for Chrome, Edge, and Firefox.",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt -b chrome --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:all": "pnpm verify:privacy && pnpm build && pnpm build:firefox && pnpm verify:manifests && pnpm lint:firefox",
    "zip:chromium": "wxt zip -b chrome --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:all": "pnpm verify:privacy && pnpm zip:chromium && pnpm zip:firefox && pnpm verify:manifests && pnpm lint:firefox && pnpm verify:packages",
    "icons:generate": "node scripts/generate-icons.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "verify:privacy": "node scripts/verify-privacy-contract.mjs",
    "verify:manifests": "node scripts/verify-manifests.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "verify:release-version": "node scripts/verify-release-version.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:all"
  },
  "dependencies": {
    "@lucide/vue": "1.31.0",
    "@tanstack/vue-virtual": "3.13.35",
    "css-tree": "3.2.1",
    "idb": "8.0.3",
    "pinia": "4.0.3",
    "sortablejs": "1.15.7",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/css-tree": "2.3.10",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-vue": "6.0.4",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.11",
    "@wxt-dev/module-vue": "1.0.3",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "fake-indexeddb": "6.2.2",
    "happy-dom": "20.11.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9",
    "web-ext": "10.6.0",
    "wxt": "0.21.4"
  }
}
